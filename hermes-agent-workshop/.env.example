# OpenRouter — LLM inference (https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-...

# Optional: overrides model.default in ~/.hermes/config.yaml.
# Must support TOOL USE, or Hermes cannot call anything. Free ids are retired without
# notice — check https://openrouter.ai/models?q=free before the session.
# Verified 2026-09-03:
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-fin:free

# AgentMail — agent-owned email inbox (https://agentmail.to)
# Sign up free at https://console.agentmail.to
AGENTMAIL_API_KEY=am_...

# Telegram (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=123456789:AAF...
TELEGRAM_ALLOWED_USERS=123456789

# Tavily — web search (https://app.tavily.com) — optional, free tier
# TAVILY_API_KEY=tvly-...
