# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Hosted free tier -------------------------------------------------------
# Free key, no credit card: https://openrouter.ai  → Keys
OPENROUTER_API_KEY=sk-or-...
# Optional: point at any OpenAI-compatible endpoint instead (proxy, gateway, other provider)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# A free model that supports tool calling — Labs 3, 5 and 6 need tool support.
# The free list ROTATES: ids are retired without notice. Verified 2026-09-03:
#   thinkingmachines/inkling-small:free
#   poolside/laguna-s-2.1:free
#   nvidia/nemotron-3.5-lightning:free
# Lab 0 has a cell that lists what is free and tool-capable right now.
MODEL=inclusionai/ling-3.0-flash-fin:free

# --- Local models (optional, fully offline) ---------------------------------
# Install https://ollama.com then: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# --- Optional, only for stretch goals ---------------------------------------
# PUSHOVER_TOKEN=
# PUSHOVER_USER=
